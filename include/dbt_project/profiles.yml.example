nyc_taxi_borough_daily:
  target: dev

  outputs:
    dev:
      type: postgres
      host: "{{ env_var('PG_HOST') }}"
      port: 5432
      user: "{{ env_var('PG_USER') }}"
      password: "{{ env_var('PG_PASSWORD') }}"
      dbname: "{{ env_var('PG_DBNAME') }}"
      schema: "{{ env_var('PG_SCHEMA') }}"
      sslmode: require
      threads: 1